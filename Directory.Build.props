<Project>
  <!-- A package with a known vulnerability fails the build instead of warning (NuGet audit: low, moderate, high,
       critical). An offline build cannot see the audit data; the first online build will. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <!-- NuGet packages: every package shares one version. Apps, tools and test projects set IsPackable false. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Maxim Konstantinovski</Authors>
    <Copyright>Copyright 2026 Maxim Konstantinovski</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mkonstan/DataGateway</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mkonstan/DataGateway</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>sql;database;read-only;json;mcp;ai;llm;aspnetcore;dapper;sqlkata</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- IntelliSense: ship the XML docs that exist. CS1591 (public member without a doc comment) is silenced until
         every public member is documented. -->
    <GenerateDocumentationFile Condition="'$(IsPackable)' != 'false'">true</GenerateDocumentationFile>
    <NoWarn Condition="'$(IsPackable)' != 'false'">$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
