    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <ProjectReference Include="../../DataGateway.Web/DataGateway.Web.csproj" />
    <ProjectReference Include="../../DataGateway.Data.SqlServer/DataGateway.Data.SqlServer.csproj" />
    <ProjectReference Include="../../DataGateway.Data.PostgreSql/DataGateway.Data.PostgreSql.csproj" />
    <ProjectReference Include="../../DataGateway.Data.Snowflake/DataGateway.Data.Snowflake.csproj" />
    <ProjectReference Include="../../DataGateway.Data.Sqlite/DataGateway.Data.Sqlite.csproj" />
    <ProjectReference Include="../../DataGateway.Demo/DataGateway.Demo.csproj" />
    <ProjectReference Include="../../DataGateway.Proxy/DataGateway.Proxy.csproj" Aliases="RegistrationProxy" />
    <Compile Include="../DataGateway.Core.Tests/TestFiles.cs" Link="TestFiles.cs" />
    <AssemblyMetadata Include="ProxyDll" Value="$(MSBuildThisFileDirectory)../../DataGateway.Proxy/bin/$(Configuration)/net10.0/DataGateway.Proxy.dll" />
  </ItemGroup>
</Project>
